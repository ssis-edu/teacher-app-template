rules_version = '2';

// The BUGGY predecessor of firestore.rules, kept ONLY as the counterfactual
// target for the harness. Do not deploy this.
//
// One line differs: `allow delete` is gated on isOwner() alone. This is the
// real hs-trip-form bug (2026-07-16) reproduced — a creator could never delete
// their own item, so on the trip form a student could never come off a trip.
// It was invisible for two days because the only caller was also broken.
//
// The harness runs the SAME cases against this file and the fixed one. The case
// "creator deletes own item" expects DENY here and ALLOW there — that flip is
// the proof the fix does what it claims, and touches nothing else.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function role() {
      return signedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.token.email))
        ? get(/databases/$(database)/documents/roles/$(request.auth.token.email)).data.role
        : null;
    }

    function isOwner() {
      return role() == 'owner';
    }

    function isCreator() {
      return signedIn()
        && resource.data.createdBy == request.auth.token.email;
    }

    match /items/{item} {
      allow read: if isOwner() || isCreator();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.token.email;
      allow update: if isOwner()
        || (isCreator()
            && request.resource.data.createdBy == resource.data.createdBy);
      // BUG: owner only. A creator cannot delete their own item.
      allow delete: if isOwner();
    }

    match /roles/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow write: if isOwner();
    }
  }
}
