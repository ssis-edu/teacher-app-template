rules_version = '2';

// The BUGGY predecessor of firestore.rules, kept ONLY as the counterfactual
// target for the harness. Do not deploy this. Its body is preserved byte for
// byte as the template actually shipped up to 2026-07-22 — that is what makes
// it evidence rather than a mock-up.
//
// TWO things differ from the fixed file, and the suite attributes every flip to
// exactly one of them:
//
//   1. NO DOMAIN GATE. Everything gates on signedIn(), which only means "a
//      verified Google token". ssis-apps has `blockingFunctions: {}`, so any
//      @gmail.com could create, read, update and delete `items` here, and read
//      a role doc. Cases labelled "non-SSIS" and "lookalike domain" flip
//      ALLOW -> DENY on that clause alone.
//      (One exception, deliberately kept in the suite: a non-SSIS DELETE is
//      denied by BOTH files. The old file refuses it only via bug 2 below —
//      two bugs cancelling is not a gate, and the moment someone fixed the
//      delete they would have opened it.)
//
//   2. `allow delete` is gated on isOwner() alone. This is the real hs-trip-form
//      bug (2026-07-16) reproduced — a creator could never delete their own
//      item, so on the trip form a student could never come off a trip. It was
//      invisible for two days because the only caller was also broken. The case
//      "creator deletes own item" expects DENY here and ALLOW there.
//
// Bug 1 also has a quieter half: with no .lower() anywhere, a mixed-case staff
// address such as `Alice@SSIS.edu.vn` is denied HER OWN item and HER OWN role
// doc. The "mixed-case" cases flip DENY -> ALLOW, which is the hs-advisory-hub
// bug caught in the template before anyone copied it.
//
// The harness runs the SAME cases against this file and the fixed one. Those
// flips are the proof the fix does what it claims, and touches nothing else.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function role() {
      return signedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.token.email))
        ? get(/databases/$(database)/documents/roles/$(request.auth.token.email)).data.role
        : null;
    }

    function isOwner() {
      return role() == 'owner';
    }

    function isCreator() {
      return signedIn()
        && resource.data.createdBy == request.auth.token.email;
    }

    match /items/{item} {
      allow read: if isOwner() || isCreator();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.token.email;
      allow update: if isOwner()
        || (isCreator()
            && request.resource.data.createdBy == resource.data.createdBy);
      // BUG: owner only. A creator cannot delete their own item.
      allow delete: if isOwner();
    }

    match /roles/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow write: if isOwner();
    }
  }
}
