rules_version = '2';

// EXAMPLE rules for the rules-harness. Not deployed anywhere — this exists so
// the harness has a real, role-gated ruleset to run against in CI, and so a new
// app has a correct pattern to copy.
//
// The model: an `items` collection owned by whoever created each doc. An
// `owner` may do anything; the item's own creator (`createdBy`) may update and
// delete their own item; nobody else may touch it. Roles come from a
// roles/{email} doc.
//
// This is the CORRECT version. examples/rules-test/firestore.previous.rules is
// the same rules with one deliberate bug — the delete gated on owner only, so
// a creator could never delete their own item. The harness proves the fix.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function role() {
      return signedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.token.email))
        ? get(/databases/$(database)/documents/roles/$(request.auth.token.email)).data.role
        : null;
    }

    function isOwner() {
      return role() == 'owner';
    }

    function isCreator() {
      return signedIn()
        && resource.data.createdBy == request.auth.token.email;
    }

    match /items/{item} {
      allow read: if isOwner() || isCreator();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.token.email;
      allow update: if isOwner()
        || (isCreator()
            && request.resource.data.createdBy == resource.data.createdBy);
      // A creator can delete their own item; an owner can delete any.
      allow delete: if isOwner() || isCreator();
    }

    match /roles/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow write: if isOwner();
    }
  }
}
